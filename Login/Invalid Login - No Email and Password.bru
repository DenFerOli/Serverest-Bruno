meta {
  name: Invalid Login - No Email and Password
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "",
    "password": ""
  }  
}

tests {
  test("1 - Status is 400", () => {
    expect(res.status).to.equal(400);
  } )
  
  test("2 - Response Contain Empty Email Field Message", () => {
    expect(res.body.email).to.equal("email não pode ficar em branco");
  })
  
  test("3 - Response Contain Empty Password Field Message", () => {
    expect(res.body.password).to.equal("password não pode ficar em branco");
  })
  
  test("4 - Response time is below or equal to 1 second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  
  // {
  //   "email": "email não pode ficar em branco",
  //   "password": "password não pode ficar em branco"
  // }
}

settings {
  encodeUrl: true
  timeout: 0
}
