meta {
  name: Invalid  Login - Incorrect Password
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "test_analyst@email.com",
    "password": "test2"
  }
}

tests {
  test("1 - Status 401 - Unauthorized", () => {
    expect(res.status).to.equal(401)
  })
  
  test("2 - Response Time Less Than 1 second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  test("3 - Invalid User or Passwod", () => {
    expect(res.body.message).to.equal("Email e/ou senha inválidos")
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
