meta {
  name: Invalid Login - Incorrect User and Password
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "test_analyst100@email.com",
    "password": "test100"
  }
}

tests {
  test("1 - Status 401", () => {
    expect(res.status).to.equal(401)
  })
  
  test("2 - Response time is below or equal to 1 second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  test("3 - Invalid User and Passwod Message", () => {
    expect(res.body.message).to.equal("Email e/ou senha inválidos")
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
