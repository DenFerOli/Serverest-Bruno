meta {
  name: Query all registered users
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/usuarios
  body: none
  auth: inherit
}

tests {
  test("1 - Response status is 200 - Ok", () => {
    expect(res.status).to.equal(200);
  });
  
  test("2 - Response time is below to 1 second", () => {
    expect(res.responseTime).to.be.below(1000)  
  });
  
  test("3 - Check data type", () => {
    expect(res.body.usuarios).to.be.an("array");
  });
  
  test("4 - Check properties", () => {
    expect(res.body).to.have.property("usuarios");
  })
  
  test("5 - Array length bigger than 0", () => {
    expect(res.body.usuarios.length).to.be.greaterThan(0);
  });
  
  test("6 - Query the structure", () => {
    const usuario = res.body.usuarios[0];
    
  expect(usuario).to.have.all.keys(
    "nome",
    "email",
    "password",
    "administrador",
    "_id"
    )
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
