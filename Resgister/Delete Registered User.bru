meta {
  name: Delete registered user
  type: http
  seq: 6
}

delete {
  url: {{baseURL}}/usuarios/{{delete_id}}
  body: none
  auth: inherit
}

tests {
  test("1 - Response status is 200 - Ok", () => {
    expect(res.status).to.equal(200)
  })
  
  test("2 - Response time is below or equal to 1 second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  test("3 - Response contain message 'Registro Excluido'", () => {
    expect(res.body.message).to.equal("Registro excluído com sucesso")
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
