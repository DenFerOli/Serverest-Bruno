meta {
  name: Update User
  type: http
  seq: 8
}

put {
  url: {{baseURL}}/usuarios/{{edit_test_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Update Test 2",
    "email": "update_test_2@email.com",
    "password": "test",
    "administrador": "true"
  }
}

tests {
  test("1 - Response Status Should Be 200 (Ok)", () => {
    expect(res.status).to.equal(200)
  })
  
  test("2 - Response Time Should Be Below To 1 Second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  test('3 - Response Message Should Be "Registro alterado com sucesso"', () => {
    expect(res.body.message).to.equal("Registro alterado com sucesso")
  })
  
  // {
  //   "message": "Registro alterado com sucesso"
  // }
}

settings {
  encodeUrl: true
  timeout: 0
}
