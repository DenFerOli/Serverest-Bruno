meta {
  name: Register user to delete
  type: http
  seq: 5
}

post {
  url: {{baseURL}}/usuarios
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Delete Test {{nome}}",
    "email": "delete_test_{{nome}}@email.com",
    "password": "teste",
    "administrador": "true"
  }
}

tests {
  const delete_id = res.getBody();
  bru.setEnvVar("delete_id", delete_id._id);
  
  test("1 - Response status is 201 - Created", () => {
    expect(res.status).to.equal(201)
  })
  
  test("2 - Response time is below or equal to 1 second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  test("3 - Response contain message 'cadastro realizado com sucesso'", () => {
    expect(res.body.message).to.equal("Cadastro realizado com sucesso")
  })
  
}

settings {
  encodeUrl: true
  timeout: 0
}
