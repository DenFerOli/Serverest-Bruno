meta {
  name: List All Registered Users
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/usuarios
  body: none
  auth: inherit
}

tests {
  test("1 - Status code 200", () => {
    expect(res.status).to.equal(200);
  });
  
  test("2 - Response time is below to 1000 milisecond", () => {
    const time = res.responseTime;
    
    expect(time).to.be.below(2000);
    
    if (time <= 500) {
      console.log("Performance Ideal");
    } else if (time <= 1000) {
      console.log("Performance Acceptable");
    } else {
      console.warn("Performance Slow")
    }
    
  });
  
  test("3 - Validar tipos de dados", () => {
    expect(res.body.usuarios).to.be.an("array");
  });
  
  test("4 - Validar propriedades", () => {
    expect(res.body).to.have.property("usuarios");
  })
  
  test("5 - Array length bigger than 0", () => {
    expect(res.body.usuarios.length).to.be.greaterThan(0);
  });
  
  test("6 - Consultar a estrutura", () => {
    const usuario = res.body.usuarios[0];
    
  expect(usuario).to.have.all.keys(
    "nome",
    "email",
    "password",
    "administrador",
    "_id"
    )
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
