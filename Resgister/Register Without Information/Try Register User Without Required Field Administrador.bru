meta {
  name: Try register user without required field Administrador
  type: http
  seq: 5
}

post {
  url: {{baseURL}}/usuarios
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Required Field",
    "email": "required_field@email.com",
    "password": "test",
    "administrador": ""
  }
}

tests {
  test("1 - Response status is 400 - Bad Request", () => {
    expect(res.status).to.equal(400)
  })
  
  test("2 - Response time is below or equal to 1 second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  test("3 - Fill administrado with 'true' or 'false' is required", () => {
    const body = res.getBody()
    expect(res.body.administrador).to.equal("administrador deve ser 'true' ou 'false'")
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
