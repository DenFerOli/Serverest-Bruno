meta {
  name: Try Register User Without Required Field Password
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/usuarios
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Required Field",
    "email": "required_field@email.com",
    "password": "",
    "administrador": "true"
  }
}

tests {
  test("1 - Response Status Is 400 - Bad Request", () => {
    expect(res.status).to.equal(400)
  })
  
  test("2 - Response Status Should Be Below To 1 Second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  test("3 - Try Register User Without Required Field Password", () => {
    const body = res.getBody()
    expect(res.body.password).to.equal("password não pode ficar em branco")
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
