meta {
  name: Try register user without required field Nome
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/usuarios
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "",
    "email": "test_analyst@email.com",
    "password": "test",
    "administrador": "true"
  }
}

tests {
  test("1 - Response status is 400 - Bad Request", () => {
    expect(res.status).to.equal(400)
  })
  
  test("2 - Response time is below or equal to 1 second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  test("3 - Field Nome is required", () => {
    const body = res.getBody();
    expect(body.nome).to.equal("nome não pode ficar em branco")
  })
  
}

settings {
  encodeUrl: true
  timeout: 0
}
