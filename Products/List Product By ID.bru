meta {
  name: List Product By ID
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/produtos/{{product_update_id}}
  body: none
  auth: inherit
}

tests {
  test("1 - Response Status Is 200 - Ok", () => {
    expect(res.status).to.equal(200)
  })
  
  test("2 - Response Time Is Below To 1 Second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
