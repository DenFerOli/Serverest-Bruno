meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/usuarios
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Test Analyst",
    "email": "test_analyst@email.com",
    "password": "test",
    "administrador": "true"
  }
}

tests {
  const responseBody = res.getBody();
  
  bru.setEnvVar("userId", responseBody._id);
  
  test("1 - Test Status 201 - User Registered", () => {
    expect(res.status).to.equal(201)
  })
  
  test("2 - Response time is below or equal to 1 second", () => {
    expect(res.responseTime).to.be.below(1000)
    //response_time()
  })
  
  test("3 - User Registered Message", () => {
    expect(res.body.message).to.equal("Cadastro realizado com sucesso");
  })
  
  // test("", () => {
  //   expect()
  // })
  
  // ✔ Status code -
  // ✔ Tempo de resposta -
  // ✔ Estrutura do JSON 
  // ✔ Tipo dos campos
  // ✔ Conteúdo específico
  // ✔ Campos obrigatórios
  // ✔ Tamanho da lista
  // ✔ Mensagem de erro correta
}

settings {
  encodeUrl: true
  timeout: 0
}
