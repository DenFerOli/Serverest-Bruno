meta {
  name: List All Products
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/produtos
  body: none
  auth: inherit
}

tests {
  test("1 - Status is 200", () => {
    expect(res.status).to.equal(200)
  })
  
  test("2 - Response Time is Below to 1 Second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
  
  
  
  
  
