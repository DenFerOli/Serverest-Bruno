meta {
  name: List All Products
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/produtos
  body: none
  auth: inherit
}

tests {
  test("1 - Status is 200", () => {
    expect(res.status).to.equal(200)
  })
  
  test("2 - Response time is below or equal to 1 second", () => {
    expect(res.responseTime).to.be.below(1000)
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
